{
  "$defs": {
    "BspConfig": {
      "additionalProperties": false,
      "description": "Linux_for_Tegra customization options.",
      "properties": {
        "overlays": {
          "description": "Files or directories copied into Linux_for_Tegra after extraction",
          "items": {
            "$ref": "#/$defs/BspOverlay"
          },
          "title": "Overlays",
          "type": "array"
        }
      },
      "title": "BspConfig",
      "type": "object"
    },
    "BspOverlay": {
      "additionalProperties": false,
      "description": "Files or directories copied into Linux_for_Tegra before later stages.",
      "properties": {
        "src": {
          "description": "Source file or directory path",
          "format": "path",
          "title": "Src",
          "type": "string"
        },
        "dest": {
          "description": "Absolute destination path within Linux_for_Tegra",
          "title": "Dest",
          "type": "string"
        }
      },
      "required": [
        "src",
        "dest"
      ],
      "title": "BspOverlay",
      "type": "object"
    },
    "DockerConfig": {
      "additionalProperties": false,
      "description": "Docker execution settings.",
      "properties": {
        "image": {
          "description": "Docker image tag used for builder containers",
          "title": "Image",
          "type": "string"
        },
        "dockerfile": {
          "default": "docker/Dockerfile",
          "description": "Path to Dockerfile used when build is true",
          "format": "path",
          "title": "Dockerfile",
          "type": "string"
        },
        "build": {
          "default": true,
          "description": "Build image locally instead of pulling",
          "title": "Build",
          "type": "boolean"
        },
        "registry": {
          "default": "",
          "description": "Optional registry prefix for image pulls/builds",
          "title": "Registry",
          "type": "string"
        },
        "privileged_for_flash": {
          "default": true,
          "description": "Run flash containers with --privileged",
          "title": "Privileged For Flash",
          "type": "boolean"
        },
        "devices": {
          "description": "Host device paths passed through for flashing",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "volumes": {
          "description": "Additional host:container[:mode] bind mounts",
          "items": {
            "type": "string"
          },
          "title": "Volumes",
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional environment variables for the container",
          "title": "Environment",
          "type": "object"
        }
      },
      "required": [
        "image"
      ],
      "title": "DockerConfig",
      "type": "object"
    },
    "KernelConfig": {
      "additionalProperties": false,
      "description": "Kernel build options.",
      "properties": {
        "source_tag": {
          "default": "",
          "description": "Kernel/device-tree tag used for the filtered source_sync.sh kernel sync; defaults to jetson_<l4t.release> when omitted",
          "title": "Source Tag",
          "type": "string"
        },
        "defconfig": {
          "default": "tegra_defconfig",
          "description": "Kernel defconfig target",
          "title": "Defconfig",
          "type": "string"
        },
        "config_fragments": {
          "description": "Optional kernel config fragment files",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Config Fragments",
          "type": "array"
        },
        "extra_dts": {
          "description": "Optional custom DTS files to include in the build",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Extra Dts",
          "type": "array"
        }
      },
      "title": "KernelConfig",
      "type": "object"
    },
    "L4TConfig": {
      "additionalProperties": false,
      "description": "Jetson Linux archive inputs.",
      "properties": {
        "release": {
          "default": "35.2.1",
          "description": "L4T release version",
          "title": "Release",
          "type": "string"
        },
        "bsp_url": {
          "description": "URL to Jetson Linux BSP archive",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Bsp Url",
          "type": "string"
        },
        "bsp_sha256": {
          "description": "SHA256 for bsp_url artifact",
          "title": "Bsp Sha256",
          "type": "string"
        },
        "sample_rootfs_url": {
          "description": "URL to sample root filesystem archive",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Sample Rootfs Url",
          "type": "string"
        },
        "sample_rootfs_sha256": {
          "description": "SHA256 for sample_rootfs_url artifact",
          "title": "Sample Rootfs Sha256",
          "type": "string"
        }
      },
      "required": [
        "bsp_url",
        "bsp_sha256",
        "sample_rootfs_url",
        "sample_rootfs_sha256"
      ],
      "title": "L4TConfig",
      "type": "object"
    },
    "ModuleEnum": {
      "description": "Supported Jetson modules.",
      "enum": [
        "p3668",
        "p3767"
      ],
      "title": "ModuleEnum",
      "type": "string"
    },
    "RootDeviceEnum": {
      "description": "Supported root device targets.",
      "enum": [
        "mmcblk0p1",
        "internal"
      ],
      "title": "RootDeviceEnum",
      "type": "string"
    },
    "RootfsConfig": {
      "additionalProperties": false,
      "description": "Rootfs customization options.",
      "properties": {
        "install_modules": {
          "default": true,
          "description": "Install kernel modules into rootfs",
          "title": "Install Modules",
          "type": "boolean"
        },
        "extra_packages": {
          "description": "Optional apt packages",
          "items": {
            "type": "string"
          },
          "title": "Extra Packages",
          "type": "array"
        },
        "overlays": {
          "description": "Files or directories copied into rootfs",
          "items": {
            "$ref": "#/$defs/RootfsOverlay"
          },
          "title": "Overlays",
          "type": "array"
        }
      },
      "title": "RootfsConfig",
      "type": "object"
    },
    "RootfsOverlay": {
      "additionalProperties": false,
      "description": "Overlay content copied into rootfs.",
      "properties": {
        "src": {
          "description": "Source file or directory path",
          "format": "path",
          "title": "Src",
          "type": "string"
        },
        "dest": {
          "description": "Absolute destination path within rootfs",
          "title": "Dest",
          "type": "string"
        }
      },
      "required": [
        "src",
        "dest"
      ],
      "title": "RootfsOverlay",
      "type": "object"
    },
    "TargetBspConfig": {
      "additionalProperties": false,
      "description": "Per-target Linux_for_Tegra overrides.",
      "properties": {
        "overlays": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/BspOverlay"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additional files or directories copied into Linux_for_Tegra",
          "title": "Overlays"
        }
      },
      "title": "TargetBspConfig",
      "type": "object"
    },
    "TargetConfig": {
      "additionalProperties": false,
      "description": "Per-target flashing options.",
      "properties": {
        "name": {
          "description": "Target name used by the CLI",
          "title": "Name",
          "type": "string"
        },
        "module": {
          "$ref": "#/$defs/ModuleEnum",
          "description": "Jetson module identifier"
        },
        "flash_config": {
          "description": "flash.sh board configuration name",
          "title": "Flash Config",
          "type": "string"
        },
        "root_device": {
          "$ref": "#/$defs/RootDeviceEnum",
          "description": "flash.sh root device argument"
        },
        "kernel": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetKernelConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-target kernel overrides"
        },
        "rootfs": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRootfsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-target rootfs overrides"
        },
        "bsp": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetBspConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-target Linux_for_Tegra overrides"
        },
        "enabled": {
          "default": true,
          "description": "Whether target is active for build/all commands",
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "module",
        "flash_config",
        "root_device"
      ],
      "title": "TargetConfig",
      "type": "object"
    },
    "TargetKernelConfig": {
      "additionalProperties": false,
      "description": "Per-target kernel overrides.",
      "properties": {
        "source_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional kernel/device-tree source tag override for this target",
          "title": "Source Tag"
        },
        "defconfig": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional kernel defconfig override for this target",
          "title": "Defconfig"
        },
        "config_fragments": {
          "anyOf": [
            {
              "items": {
                "format": "path",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additional kernel config fragments for this target",
          "title": "Config Fragments"
        },
        "extra_dts": {
          "anyOf": [
            {
              "items": {
                "format": "path",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additional custom DTS files for this target",
          "title": "Extra Dts"
        }
      },
      "title": "TargetKernelConfig",
      "type": "object"
    },
    "TargetRootfsConfig": {
      "additionalProperties": false,
      "description": "Per-target rootfs overrides.",
      "properties": {
        "install_modules": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional override for installing kernel modules into rootfs",
          "title": "Install Modules"
        },
        "extra_packages": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additional apt packages for this target",
          "title": "Extra Packages"
        },
        "overlays": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RootfsOverlay"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional additional files or directories copied into rootfs",
          "title": "Overlays"
        }
      },
      "title": "TargetRootfsConfig",
      "type": "object"
    },
    "ToolchainConfig": {
      "additionalProperties": false,
      "description": "Cross compilation toolchain metadata.",
      "properties": {
        "name": {
          "default": "bootlin-gcc-9.3",
          "description": "Toolchain name identifier",
          "title": "Name",
          "type": "string"
        },
        "url": {
          "description": "Toolchain archive URL",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "description": "SHA256 for toolchain archive",
          "title": "Sha256",
          "type": "string"
        },
        "cross_compile_prefix": {
          "default": "aarch64-buildroot-linux-gnu-",
          "description": "Cross-compiler prefix used for kernel build",
          "title": "Cross Compile Prefix",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "title": "ToolchainConfig",
      "type": "object"
    },
    "WorkspaceConfig": {
      "additionalProperties": false,
      "description": "Workspace options inside the builder container.",
      "properties": {
        "root": {
          "default": "/workspace/build",
          "description": "Workspace root inside container",
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "keep_intermediate": {
          "default": true,
          "description": "Keep intermediate artifacts",
          "title": "Keep Intermediate",
          "type": "boolean"
        }
      },
      "title": "WorkspaceConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root build configuration.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "description": "Schema version",
      "title": "Version",
      "type": "integer"
    },
    "docker": {
      "$ref": "#/$defs/DockerConfig"
    },
    "l4t": {
      "$ref": "#/$defs/L4TConfig"
    },
    "toolchain": {
      "$ref": "#/$defs/ToolchainConfig"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceConfig"
    },
    "kernel": {
      "$ref": "#/$defs/KernelConfig"
    },
    "rootfs": {
      "$ref": "#/$defs/RootfsConfig"
    },
    "bsp": {
      "$ref": "#/$defs/BspConfig"
    },
    "targets": {
      "description": "Jetson targets sharing the same kernel and rootfs build",
      "items": {
        "$ref": "#/$defs/TargetConfig"
      },
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "docker",
    "l4t",
    "toolchain",
    "targets"
  ],
  "title": "BuildConfig",
  "type": "object"
}